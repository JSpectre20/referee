# Formal checks for the sequencer (properties live in src/seq.v under `ifdef FORMAL`).
#
#   sby -f seq.sby            run every task
#   sby -f seq.sby prove      unbounded proof (k-induction) of the timing contract
#   sby -f seq.sby cover      the interesting paths are reachable
#   sby -f seq.sby mutant     negative control: a WAIT one cycle too long.
#                             This task is EXPECTED TO FAIL; sby reports it as
#                             passing only when the assertion catches the bug.
#
# The program memory is left arbitrary, so the proof covers every program.
# ADDR_W is shrunk to 3 (8 words) to keep the solver fast; nothing in the
# properties depends on the memory size.
[tasks]
prove
cover
mutant

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12
mutant: mode prove
mutant: depth 8
mutant: expect fail

[engines]
smtbmc yices

[script]
prove:  read_verilog -formal seq.v
cover:  read_verilog -formal seq.v
mutant: read_verilog -formal -DSEQ_MUTANT_WAIT seq.v
chparam -set ADDR_W 3 seq
prep -top seq

[files]
../src/seq.v
