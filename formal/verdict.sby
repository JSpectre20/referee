# Verdict soundness: src/verdict.v on top of src/edge_ts.v, against the true
# interval at sub-cycle (tick) resolution. Harness: verdict_formal.sv.
#
#   bmc4              bounded cross-check, 96 ticks (24 cycles), K = 4, u = 2
#   prove4 / prove8   unbounded proof (k-induction), K = 4 / 8 ticks per cycle, u = 2
#   cover4            every verdict reachable; INDETERMINATE on both sides of the
#                     bound; measurement error above one cycle reachable
#   u1                negative control: u = 1. EXPECTED TO FAIL; the
#                     counterexample is kept in docs/results/.
#   sharp4 / sharp8   the sharper rule (VIOLATION also when m+u == N), u = 2
#   glitch            negative control: levels may last a single tick (no hold
#                     precondition). EXPECTED TO FAIL: a pulse can vanish between
#                     two samples. Counterexample in docs/results/.
#   comb              the verdict block alone (verdict_comb.sv): the two-sided rule is
#                     sound for every m, n_lo, inexact, is_max when |m - T| < 2 cycles
#   comb_cover        every verdict reachable in that theorem, with inexact bounds
#   comb_onesided     negative control: the block sees only the rounded-down bound.
#                     EXPECTED TO FAIL (two-sided rounding is needed)
#   comb_u1           negative control: u = 1. EXPECTED TO FAIL
[tasks]
bmc4
glitch
prove4
prove8
cover4
u1
sharp4
sharp8
comb
comb_cover
comb_onesided
comb_u1

[options]
multiclock on
glitch: mode bmc
glitch: depth 80
glitch: expect fail
bmc4: mode bmc
bmc4: depth 96
prove4: mode prove
prove4: depth 40
prove8: mode prove
prove8: depth 80
cover4: mode cover
cover4: depth 120
u1: mode bmc
u1: depth 120
u1: expect fail
sharp4: mode prove
sharp4: depth 40
sharp8: mode prove
sharp8: depth 80
comb: mode prove
comb: depth 1
comb_cover: mode cover
comb_cover: depth 1
comb_onesided: mode bmc
comb_onesided: depth 1
comb_onesided: expect fail
comb_u1: mode bmc
comb_u1: depth 1
comb_u1: expect fail

[engines]
glitch: smtbmc yices
prove4: smtbmc yices
prove8: smtbmc yices
sharp4: smtbmc yices
sharp8: smtbmc yices
bmc4: smtbmc yices
cover4: smtbmc yices
u1: smtbmc yices
comb: smtbmc bitwuzla
comb_cover: smtbmc bitwuzla
comb_onesided: smtbmc bitwuzla
comb_u1: smtbmc bitwuzla

[script]
read_verilog -formal -DFORMAL edge_ts.v
read_verilog -formal -DFORMAL snapshot.v
read_verilog -formal verdict.v
comb:          read_verilog -formal -sv verdict_comb.sv
comb_cover:    read_verilog -formal -sv verdict_comb.sv
comb_onesided: read_verilog -formal -sv verdict_comb.sv
comb_u1:       read_verilog -formal -sv verdict_comb.sv
comb_onesided: chparam -set ONESIDED 1 verdict_comb
comb_u1:       chparam -set U_CYC 1 verdict_comb
glitch: read_verilog -formal -sv -DNO_INVARIANTS verdict_formal.sv
bmc4:   read_verilog -formal -sv verdict_formal.sv
prove4: read_verilog -formal -sv verdict_formal.sv
prove8: read_verilog -formal -sv verdict_formal.sv
cover4: read_verilog -formal -sv verdict_formal.sv
u1:     read_verilog -formal -sv verdict_formal.sv
sharp4: read_verilog -formal -sv verdict_formal.sv
sharp8: read_verilog -formal -sv verdict_formal.sv
prove8: chparam -set K_W 3 verdict_formal
u1:     chparam -set U_CYC 1 verdict_formal
glitch: chparam -set HOLD 1 verdict_formal
sharp4: chparam -set SHARP 1 verdict_formal
sharp8: chparam -set SHARP 1 -set K_W 3 verdict_formal
comb:          prep -top verdict_comb
comb_cover:    prep -top verdict_comb
comb_onesided: prep -top verdict_comb
comb_u1:       prep -top verdict_comb
bmc4:   prep -top verdict_formal
glitch: prep -top verdict_formal
prove4: prep -top verdict_formal
prove8: prep -top verdict_formal
cover4: prep -top verdict_formal
u1:     prep -top verdict_formal
sharp4: prep -top verdict_formal
sharp8: prep -top verdict_formal

[files]
../src/edge_ts.v
../src/snapshot.v
../src/verdict.v
verdict_formal.sv
verdict_comb.sv
